                                            class="w-12 h-12 bg-gradient-to-br from-deepred-500 via-saffron-500 to-gold-500 rounded-lg flex items-center justify-center">
                                            <i class="fa-solid fa-om text-white text-2xl"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div
                                class="absolute -top-3 left-1/2 -translate-x-1/2 bg-deepred-600 text-white text-xs font-bold px-3 py-1 rounded-full shadow-md">
                                UPI QR</div>
                        </div>

                        <div class="bg-cream-50 w-full rounded-2xl border border-cream-200 p-5 mb-5">
                            <p class="text-xs text-gray-400 uppercase tracking-wider font-semibold mb-2 text-center">Or
                                Scan UPI ID</p>
                            <div
                                class="flex items-center justify-between bg-white rounded-xl p-3 border border-gray-100 shadow-sm">
                                <div class="flex items-center space-x-3">
                                    <div
                                        class="w-10 h-10 bg-gradient-to-br from-saffron-500 to-deepred-600 rounded-xl flex items-center justify-center">
                                        <i class="fa-solid fa-mobile-screen-button text-white"></i>
                                    </div>
                                    <div>
                                        <p class="text-xs text-gray-400">UPI ID</p>
                                        <p class="font-bold text-gray-800">shreeram@foundation</p>
                                    </div>
                                </div>
                                <button onclick="copyText('shreeram@foundation')"
                                    class="p-2 text-gray-400 hover:text-deepred-600 hover:bg-deepred-50 rounded-lg transition-colors"
                                    title="Copy UPI ID">
                                    <i class="fa-regular fa-copy"></i>
                                </button>
                            </div>
                        </div>

                        <div class="w-full grid grid-cols-3 gap-3">
                            <div
                                class="flex flex-col items-center p-3 bg-cream-50 rounded-xl border border-cream-200 hover:bg-cream-100 transition-colors">
                                <div
                                    class="w-10 h-10 bg-white rounded-xl shadow-sm flex items-center justify-center mb-1">
                                    <i class="fa-brands fa-google-pay text-2xl text-saffron-600"></i>
                                </div>
                                <span class="text-xs font-medium text-gray-600">GPay</span>
                            </div>
                            <div
                                class="flex flex-col items-center p-3 bg-cream-50 rounded-xl border border-cream-200 hover:bg-cream-100 transition-colors">
                                <div
                                    class="w-10 h-10 bg-white rounded-xl shadow-sm flex items-center justify-center mb-1">
                                    <i class="fa-solid fa-mobile-screen text-2xl text-green-600"></i>
                                </div>
                                <span class="text-xs font-medium text-gray-600">PhonePe</span>
                            </div>
                            <div
                                class="flex flex-col items-center p-3 bg-cream-50 rounded-xl border border-cream-200 hover:bg-cream-100 transition-colors">
                                <div
                                    class="w-10 h-10 bg-white rounded-xl shadow-sm flex items-center justify-center mb-1">
                                    <i class="fa-solid fa-wallet text-2xl text-sky-600"></i>
                                </div>
                                <span class="text-xs font-medium text-gray-600">Paytm</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div
                class="bg-gradient-to-r from-deepred-600 via-deepred-700 to-deepred-600 rounded-3xl p-6 sm:p-8 mb-10 shadow-2xl">
                <div class="flex flex-col sm:flex-row items-start sm:items-center space-y-3 sm:space-y-0 sm:space-x-6">
                    <div
                        class="w-16 h-16 bg-white/15 backdrop-blur rounded-2xl flex items-center justify-center flex-shrink-0 border border-white/20">
                        <i class="fa-solid fa-file-invoice text-3xl text-gold-300"></i>
                    </div>
                    <div class="flex-1">
                        <h4 class="font-playfair text-xl sm:text-2xl font-bold text-white mb-1 flex items-center">
                            <i class="fa-solid fa-triangle-exclamation text-gold-300 mr-3"></i>
                            Important Notice for All Donors
                        </h4>
                        <p class="text-white/90 text-base sm:text-lg">
                            Please fill out the <strong>Receipt Form below</strong> immediately after making any
                            transfer (Bank / UPI). This helps us verify your donation and issue your <strong
                                class="text-gold-300">80G Tax Receipt</strong> within 48 hours to your registered email.
                        </p>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-3xl shadow-xl border border-saffron-100 overflow-hidden">
                <div class="bg-gradient-to-r from-saffron-600 via-saffron-500 to-gold-500 p-6 sm:p-7 text-white">
                    <div class="flex items-center space-x-3">
                        <div class="w-11 h-11 bg-white/15 rounded-xl flex items-center justify-center">
                            <i class="fa-solid fa-pen-to-square text-xl"></i>
                        </div>
                        <div>
                            <h3 class="font-playfair text-2xl font-bold">Donation Receipt & 80G Form</h3>
                            <p class="text-white/90 text-sm">Fill this form after making the payment to receive your tax
                                certificate</p>
                        </div>
                    </div>
                </div>

                <form id="donationForm" class="p-6 sm:p-10">
                    <div class="grid md:grid-cols-2 gap-6 mb-8">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                Full Name <span class="text-deepred-500">*</span>
                            </label>
                            <div class="relative">
                                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"><i
                                        class="fa-solid fa-user"></i></span>
                                <input type="text" required
                                    class="w-full pl-11 pr-4 py-3.5 rounded-xl border-2 border-gray-200 focus:border-saffron-500 focus:ring-4 focus:ring-saffron-100 outline-none transition-all bg-cream-50/50"
                                    placeholder="Enter your full name">
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                Phone Number <span class="text-deepred-500">*</span>
                            </label>
                            <div class="relative">
                                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"><i
                                        class="fa-solid fa-phone"></i></span>
                                <span
                                    class="absolute left-12 top-1/2 -translate-y-1/2 text-gray-500 font-semibold border-r border-gray-200 pr-3">+91</span>
                                <input type="tel" required pattern="[0-9]{10}"
                                    class="w-full pl-28 pr-4 py-3.5 rounded-xl border-2 border-gray-200 focus:border-saffron-500 focus:ring-4 focus:ring-saffron-100 outline-none transition-all bg-cream-50/50"
                                    placeholder="10-digit mobile number">
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                Email Address <span class="text-gray-400 font-normal">(for 80G receipt)</span>
                            </label>
                            <div class="relative">
                                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"><i
                                        class="fa-solid fa-envelope"></i></span>
                                <input type="email"
                                    class="w-full pl-11 pr-4 py-3.5 rounded-xl border-2 border-gray-200 focus:border-saffron-500 focus:ring-4 focus:ring-saffron-100 outline-none transition-all bg-cream-50/50"
                                    placeholder="you@example.com">
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                Donation Date <span class="text-deepred-500">*</span>
                            </label>
                            <div class="relative">
                                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"><i
                                        class="fa-solid fa-calendar"></i></span>
                                <input type="date" required
                                    class="w-full pl-11 pr-4 py-3.5 rounded-xl border-2 border-gray-200 focus:border-saffron-500 focus:ring-4 focus:ring-saffron-100 outline-none transition-all bg-cream-50/50">
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                Transaction ID / UTR No. <span class="text-deepred-500">*</span>
                            </label>
                            <div class="relative">
                                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"><i
                                        class="fa-solid fa-hashtag"></i></span>
                                <input type="text" required
                                    class="w-full pl-11 pr-4 py-3.5 rounded-xl border-2 border-gray-200 focus:border-saffron-500 focus:ring-4 focus:ring-saffron-100 outline-none transition-all bg-cream-50/50 uppercase"
                                    placeholder="e.g. 456789012345 (12-digit UTR / UPI Ref ID)">
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                Amount Paid (₹) <span class="text-deepred-500">*</span>
                            </label>
                            <div class="relative">
                                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"><i
                                        class="fa-solid fa-indian-rupee-sign"></i></span>
                                <input type="number" required min="1"
                                    class="w-full pl-11 pr-4 py-3.5 rounded-xl border-2 border-gray-200 focus:border-saffron-500 focus:ring-4 focus:ring-saffron-100 outline-none transition-all bg-cream-50/50"
                                    placeholder="Enter donation amount">
                            </div>
                            <div class="flex flex-wrap gap-2 mt-3">
                                <button type="button" onclick="setAmount(101)"
                                    class="px-3 py-1.5 text-xs font-semibold bg-saffron-50 text-saffron-700 border border-saffron-200 rounded-lg hover:bg-saffron-100 transition-colors">₹101</button>
                                <button type="button" onclick="setAmount(501)"
                                    class="px-3 py-1.5 text-xs font-semibold bg-saffron-50 text-saffron-700 border border-saffron-200 rounded-lg hover:bg-saffron-100 transition-colors">₹501</button>
                                <button type="button" onclick="setAmount(1001)"
                                    class="px-3 py-1.5 text-xs font-semibold bg-saffron-50 text-saffron-700 border border-saffron-200 rounded-lg hover:bg-saffron-100 transition-colors">₹1,001</button>
                                <button type="button" onclick="setAmount(5100)"
                                    class="px-3 py-1.5 text-xs font-semibold bg-saffron-50 text-saffron-700 border border-saffron-200 rounded-lg hover:bg-saffron-100 transition-colors">₹5,100</button>
                                <button type="button" onclick="setAmount(11000)"
                                    class="px-3 py-1.5 text-xs font-semibold bg-saffron-50 text-saffron-700 border border-saffron-200 rounded-lg hover:bg-saffron-100 transition-colors">₹11,000</button>
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                Payment Mode
                            </label>
                            <div class="relative">
                                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"><i
                                        class="fa-solid fa-credit-card"></i></span>
                                <select
                                    class="w-full pl-11 pr-4 py-3.5 rounded-xl border-2 border-gray-200 focus:border-saffron-500 focus:ring-4 focus:ring-saffron-100 outline-none transition-all bg-cream-50/50 appearance-none">
                                    <option>Bank Transfer (NEFT/RTGS/IMPS)</option>
                                    <option>UPI — Google Pay / PhonePe / Paytm</option>
                                    <option>Cheque / DD</option>
                                    <option>Cash Deposit</option>
                                    <option>Other</option>
                                </select>
                                <span
                                    class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none"><i
                                        class="fa-solid fa-chevron-down text-xs"></i></span>
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                PAN Number <span class="text-gray-400 font-normal">(Required for 80G receipt above
                                    ₹50K)</span>
                            </label>
                            <div class="relative">
                                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"><i
                                        class="fa-solid fa-id-card"></i></span>
                                <input type="text" pattern="[A-Z]{5}[0-9]{4}[A-Z]{1}"
                                    class="w-full pl-11 pr-4 py-3.5 rounded-xl border-2 border-gray-200 focus:border-saffron-500 focus:ring-4 focus:ring-saffron-100 outline-none transition-all bg-cream-50/50 uppercase"
                                    placeholder="e.g. ABCDE1234F">
                            </div>
                        </div>
                    </div>

                    <div class="mb-8">
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            Which cause would you like to support? (Optional)
                        </label>
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                            <label class="cursor-pointer">
                                <input type="radio" name="cause" class="peer sr-only" checked>
                                <div
                                    class="p-4 rounded-xl border-2 border-gray-200 peer-checked:border-deepred-500 peer-checked:bg-deepred-50 hover:border-saffron-300 transition-all text-center">
                                    <i class="fa-solid fa-bowl-food text-xl text-deepred-500 mb-2"></i>
                                    <p class="font-semibold text-sm text-gray-700">Annadaanam</p>
                                </div>
                            </label>
                            <label class="cursor-pointer">
                                <input type="radio" name="cause" class="peer sr-only">
                                <div
                                    class="p-4 rounded-xl border-2 border-gray-200 peer-checked:border-saffron-500 peer-checked:bg-saffron-50 hover:border-saffron-300 transition-all text-center">
                                    <i class="fa-solid fa-cow text-xl text-saffron-500 mb-2"></i>
                                    <p class="font-semibold text-sm text-gray-700">Gau Seva</p>
                                </div>
                            </label>
                            <label class="cursor-pointer">
                                <input type="radio" name="cause" class="peer sr-only">
                                <div
                                    class="p-4 rounded-xl border-2 border-gray-200 peer-checked:border-gold-500 peer-checked:bg-gold-50 hover:border-saffron-300 transition-all text-center">
                                    <i class="fa-solid fa-book-open-reader text-xl text-gold-600 mb-2"></i>
                                    <p class="font-semibold text-sm text-gray-700">Education</p>
                                </div>
                            </label>
                            <label class="cursor-pointer">
                                <input type="radio" name="cause" class="peer sr-only">
                                <div
                                    class="p-4 rounded-xl border-2 border-gray-200 peer-checked:border-red-500 peer-checked:bg-red-50 hover:border-saffron-300 transition-all text-center">
                                    <i class="fa-solid fa-kit-medical text-xl text-red-500 mb-2"></i>
                                    <p class="font-semibold text-sm text-gray-700">Medical</p>
                                </div>
                            </label>
                        </div>
                    </div>

                    <div class="mb-8 p-5 bg-gray-50 rounded-2xl border border-gray-100">
                        <label class="flex items-start space-x-3 cursor-pointer">
                            <input type="checkbox" required class="mt-1 w-5 h-5 accent-deepred-600 rounded-lg">
                            <span class="text-sm text-gray-600">
                                I confirm that the above donation is voluntary and made out of my own free will. I agree
                                to the <a href="#" class="text-deepred-600 font-semibold underline">Terms &
                                    Conditions</a> and <a href="#"
                                    class="text-deepred-600 font-semibold underline">Privacy Policy</a> of Shree Ram
                                Foundation. The 80G receipt will be shared on the email/phone provided above.
                            </span>
                        </label>
                    </div>

                    <div
                        class="flex flex-col sm:flex-row gap-4 items-center justify-between pt-4 border-t border-gray-100">
                        <p class="text-sm text-gray-500 flex items-center">
                            <i class="fa-solid fa-lock text-saffron-500 mr-2"></i>
                            Your personal information is 100% secure and never shared.
                        </p>
                        <button type="submit"
                            class="btn-primary text-white px-10 py-4 rounded-full font-bold text-lg shadow-xl flex items-center justify-center space-x-3 w-full sm:w-auto">
                            <i class="fa-solid fa-paper-plane text-xl"></i>
                            <span>Submit & Get 80G Receipt</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </section>

    <!-- Legal & Transparency Footer -->
    <footer id="contact"
        class="bg-gradient-to-br from-gray-900 via-deepred-900 to-gray-900 text-white relative overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-deepred-500 via-saffron-400 to-gold-500">
        </div>
        <div class="pattern-overlay absolute inset-0 opacity-10"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-10 relative">
            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8 mb-16">
                <div class="lg:col-span-1">
                    <div class="flex items-center space-x-3 mb-6">
                        <div
                            class="w-14 h-14 rounded-full bg-gradient-to-br from-saffron-400 via-gold-400 to-deepred-500 flex items-center justify-center shadow-lg">
                            <i class="fa-solid fa-om text-white text-2xl"></i>
                        </div>
                        <div>
                            <h3 class="font-playfair font-bold text-2xl text-white">Shree Ram</h3>
                            <p class="text-xs text-gold-300 font-medium tracking-widest uppercase">Foundation</p>
                        </div>
                    </div>
