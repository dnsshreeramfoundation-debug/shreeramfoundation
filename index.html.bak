<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shree Ram Foundation - Servicing Humanity with Devotion & Compassion</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;800&family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        saffron: {
                            50: '#FFF8F0',
                            100: '#FFEED6',
                            200: '#FFD9A8',
                            300: '#FFBF6E',
                            400: '#FFA94D',
                            500: '#FF9933',
                            600: '#E67E1A',
                            700: '#BF5E0D',
                            800: '#99480A',
                            900: '#7A3A08',
                        },
                        deepred: {
                            50: '#FFF5F5',
                            100: '#FED7D7',
                            200: '#FEB2B2',
                            300: '#FC8181',
                            400: '#F56565',
                            500: '#B91C1C',
                            600: '#991B1B',
                            700: '#7F1D1D',
                            800: '#6B1C1C',
                            900: '#450A0A',
                        },
                        gold: {
                            50: '#FFFBEB',
                            100: '#FEF3C7',
                            200: '#FDE68A',
                            300: '#FCD34D',
                            400: '#FBBF24',
                            500: '#D4A017',
                            600: '#B8860B',
                            700: '#926911',
                            800: '#725212',
                            900: '#5C420E',
                        },
                        cream: {
                            50: '#FFFBF5',
                            100: '#FFF8ED',
                            200: '#FFEFC9',
                        },
                    },
                    fontFamily: {
                        'playfair': ['Playfair Display', 'serif'],
                        'poppins': ['Poppins', 'sans-serif'],
                    },
                }
            }
        }
    </script>
    <style>
        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Poppins', sans-serif;
        }

        .font-playfair {
            font-family: 'Playfair Display', serif;
        }

        .hero-bg {
            background: linear-gradient(135deg, rgba(185, 28, 28, 0.85) 0%, rgba(255, 153, 51, 0.75) 100%),
                url('https://images.unsplash.com/photo-1604608672516-f1b9b1dba606?w=1920&q=80') center/cover no-repeat;
        }

        .pattern-overlay {
            background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23D4A017' fill-opacity='0.08'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
        }

        .card-hover {
            transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .card-hover:hover {
            transform: translateY(-8px);
            box-shadow: 0 25px 50px -12px rgba(185, 28, 28, 0.25);
        }

        .gallery-item img {
            transition: transform 0.5s ease;
        }

        .gallery-item:hover img {
            transform: scale(1.08);
        }

        .nav-link {
            position: relative;
            transition: color 0.3s ease;
        }

        .nav-link::after {
            content: '';
            position: absolute;
            bottom: -4px;
            left: 0;
            width: 0;
            height: 2px;
            background: linear-gradient(90deg, #FF9933, #B91C1C);
            transition: width 0.3s ease;
        }

        .nav-link:hover::after {
            width: 100%;
        }

        .gradient-text {
            background: linear-gradient(135deg, #B91C1C 0%, #FF9933 50%, #D4A017 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .btn-primary {
            background: linear-gradient(135deg, #B91C1C 0%, #991B1B 100%);
            transition: all 0.3s ease;
        }

        .btn-primary:hover {
            background: linear-gradient(135deg, #991B1B 0%, #7F1D1D 100%);
            transform: translateY(-2px);
            box-shadow: 0 10px 25px -5px rgba(185, 28, 28, 0.4);
        }

        .btn-secondary {
            background: linear-gradient(135deg, #FF9933 0%, #E67E1A 100%);
            transition: all 0.3s ease;
        }

        .btn-secondary:hover {
            background: linear-gradient(135deg, #E67E1A 0%, #BF5E0D 100%);
            transform: translateY(-2px);
            box-shadow: 0 10px 25px -5px rgba(255, 153, 51, 0.4);
        }

        .section-divider {
            height: 4px;
            width: 80px;
            background: linear-gradient(90deg, #B91C1C, #FF9933, #D4A017);
            border-radius: 2px;
        }

        .qr-placeholder {
            background: repeating-linear-gradient(45deg,
                    #FFF8ED,
                    #FFF8ED 10px,
                    #FFEFC9 10px,
                    #FFEFC9 20px);
        }

        @keyframes float {

            0%,
            100% {
                transform: translateY(0px);
            }

            50% {
                transform: translateY(-10px);
            }
        }

        .float-animation {
            animation: float 3s ease-in-out infinite;
        }

        .mobile-menu {
            transform: translateX(100%);
            transition: transform 0.3s ease;
        }

        .mobile-menu.active {
            transform: translateX(0);
        }
    </style>
</head>

<body class="bg-cream-50 text-gray-800 overflow-x-hidden">

    <!-- Header / Navigation -->
    <header id="home" class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-md shadow-md">
        <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-20">
                <a href="#home" class="flex items-center space-x-3">
                    <div
                        class="w-12 h-12 rounded-full bg-gradient-to-br from-saffron-500 to-deepred-600 flex items-center justify-center shadow-lg">
                        <i class="fa-solid fa-om text-white text-xl"></i>
                    </div>
                    <div>
                        <h1 class="font-playfair font-bold text-xl sm:text-2xl gradient-text leading-tight">Shree Ram
                        </h1>
                        <p class="text-xs text-gray-500 font-medium tracking-wider uppercase">Foundation</p>
                    </div>
                </a>

                <div class="hidden lg:flex items-center space-x-8">
                    <a href="#home" class="nav-link text-gray-700 hover:text-deepred-600 font-medium">Home</a>
                    <a href="#about" class="nav-link text-gray-700 hover:text-deepred-600 font-medium">About Us</a>
                    <a href="#work" class="nav-link text-gray-700 hover:text-deepred-600 font-medium">Our Work</a>
                    <a href="#gallery" class="nav-link text-gray-700 hover:text-deepred-600 font-medium">Gallery</a>
                    <a href="#donate" class="nav-link text-gray-700 hover:text-deepred-600 font-medium">Donate</a>
                    <a href="#contact" class="nav-link text-gray-700 hover:text-deepred-600 font-medium">Contact</a>
                    <a href="#donate"
                        class="btn-primary text-white px-6 py-2.5 rounded-full font-semibold shadow-lg flex items-center space-x-2">
                        <i class="fa-solid fa-heart"></i>
                        <span>Donate Now</span>
                    </a>
                </div>

                <button id="mobileMenuBtn" class="lg:hidden p-2 text-gray-700 hover:text-deepred-600">
                    <i class="fa-solid fa-bars text-2xl"></i>
                </button>
            </div>
        </nav>

        <div id="mobileMenu" class="mobile-menu fixed top-0 right-0 h-full w-72 bg-white shadow-2xl lg:hidden z-50">
            <div class="p-6 border-b border-gray-100 flex justify-between items-center">
                <h3 class="font-playfair font-bold text-lg gradient-text">Menu</h3>
                <button id="closeMenuBtn" class="p-2 text-gray-500 hover:text-deepred-600">
                    <i class="fa-solid fa-xmark text-xl"></i>
                </button>
            </div>
            <div class="p-6 flex flex-col space-y-5">
                <a href="#home"
                    class="mobile-link text-gray-700 hover:text-deepred-600 font-medium py-2 border-b border-gray-50 flex items-center space-x-3"><i
                        class="fa-solid fa-house text-saffron-500"></i><span>Home</span></a>
                <a href="#about"
                    class="mobile-link text-gray-700 hover:text-deepred-600 font-medium py-2 border-b border-gray-50 flex items-center space-x-3"><i
                        class="fa-solid fa-circle-info text-saffron-500"></i><span>About Us</span></a>
                <a href="#work"
                    class="mobile-link text-gray-700 hover:text-deepred-600 font-medium py-2 border-b border-gray-50 flex items-center space-x-3"><i
                        class="fa-solid fa-hands-holding text-saffron-500"></i><span>Our Work</span></a>
                <a href="#gallery"
                    class="mobile-link text-gray-700 hover:text-deepred-600 font-medium py-2 border-b border-gray-50 flex items-center space-x-3"><i
                        class="fa-solid fa-images text-saffron-500"></i><span>Gallery</span></a>
                <a href="#donate"
                    class="mobile-link text-gray-700 hover:text-deepred-600 font-medium py-2 border-b border-gray-50 flex items-center space-x-3"><i
                        class="fa-solid fa-hand-holding-heart text-saffron-500"></i><span>Donate</span></a>
                <a href="#contact"
                    class="mobile-link text-gray-700 hover:text-deepred-600 font-medium py-2 border-b border-gray-50 flex items-center space-x-3"><i
                        class="fa-solid fa-envelope text-saffron-500"></i><span>Contact</span></a>
                <a href="#donate"
                    class="btn-primary text-white px-6 py-3 rounded-full font-semibold text-center mt-4 flex items-center justify-center space-x-2">
                    <i class="fa-solid fa-heart"></i>
                    <span>Donate Now</span>
                </a>
            </div>
        </div>
        <div id="menuOverlay" class="hidden fixed inset-0 bg-black/40 z-40 lg:hidden"></div>
    </header>

    <!-- Hero Section -->
    <section class="hero-bg min-h-screen flex items-center pt-20 pattern-overlay">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 w-full">
            <div class="max-w-4xl">
                <div
                    class="inline-flex items-center bg-white/15 backdrop-blur-sm border border-white/20 rounded-full px-5 py-2 mb-8">
                    <span class="w-2 h-2 bg-gold-400 rounded-full animate-pulse mr-2"></span>
                    <span class="text-white/90 text-sm font-medium">Serving Mankind Since 2024</span>
                </div>

                <h1
                    class="font-playfair text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-bedge leading-tight mb-6">
                    Servicing Humanity with
                    <span class="block text-gold-300 italic mt-2">Devotion & Compassion</span>
                </h1>

                <p class="text-lg sm:text-xl text-white/85 mb-10 max-w-3xl leading-relaxed">
                    Shree Ram Foundation is dedicated to the noble cause of social welfare — from <strong
                        class="text-gold-300">Gaushala Sewa</strong> and <strong
                        class="text-gold-300">Annadaanam</strong> (free food distribution) to <strong
                        class="text-gold-300">child education</strong> and <strong class="text-gold-300">medical
                        assistance</strong> for the underprivileged. Together, let's build a world where no one sleeps
                    hungry and every soul is cared for.
                </p>

                <div class="flex flex-col sm:flex-row gap-4 sm:gap-5">
                    <a href="#donate"
                        class="btn-secondary text-white px-8 py-4 rounded-full font-bold text-lg shadow-xl flex items-center justify-center space-x-3">
                        <i class="fa-solid fa-hand-holding-heart text-xl"></i>
                        <span>Donate Now</span>
                    </a>
                    <a href="#work"
                        class="bg-white text-deepred-600 hover:bg-cream-100 px-8 py-4 rounded-full font-bold text-lg shadow-xl transition-all flex items-center justify-center space-x-3 transform hover:-translate-y-1">
                        <i class="fa-solid fa-eye text-xl"></i>
                        <span>Our Work</span>
                    </a>
                </div>

                <div class="grid grid-cols-3 gap-4 sm:gap-8 mt-16 pt-10 border-t border-white/20 max-w-3xl">
                    <div>
                        <h3 class="font-playfair text-3xl sm:text-4xl font-bold text-gold-300">5K+</h3>
                        <p class="text-white/70 text-sm mt-1">Lives Impacted</p>
                    </div>
                    <div>
                        <h3 class="font-playfair text-3xl sm:text-4xl font-bold text-gold-300">50+</h3>
                        <p class="text-white/70 text-sm mt-1">Food Bhandara</p>
                    </div>
                    <div>
                        <h3 class="font-playfair text-3xl sm:text-4xl font-bold text-gold-300">200+</h3>
                        <p class="text-white/70 text-sm mt-1">Cows Protected</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- About Us Section -->
    <section id="about" class="py-20 sm:py-28 bg-cream-50 pattern-overlay">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <span class="inline-block text-saffron-600 font-semibold uppercase tracking-widest text-sm mb-3">Know Us
                    Better</span>
                <h2 class="font-playfair text-4xl sm:text-5xl font-bold text-gray-800 mb-4">About <span
                        class="gradient-text">Shree Ram Foundation</span></h2>
                <div class="section-divider mx-auto mb-6"></div>
                <p class="text-gray-600 max-w-2xl mx-auto text-lg">A spiritual journey of selfless service, rooted in
                    the divine teachings of Lord Shri Ram</p>
            </div>

            <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center mb-20">
                <div class="relative">
                    <div class="absolute -top-4 -left-4 w-24 h-24 bg-saffron-300 rounded-3xl opacity-50"></div>
                    <div class="absolute -bottom-4 -right-4 w-32 h-32 bg-deepred-200 rounded-3xl opacity-50"></div>
                    <img src="https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?w=800&q=80"
                        alt="Foundation volunteers at work"
                        class="relative rounded-3xl shadow-2xl w-full h-[420px] object-cover float-animation">
                    <div
                        class="absolute bottom-6 left-6 bg-white rounded-2xl px-6 py-4 shadow-xl flex items-center space-x-3">
                        <div
                            class="w-12 h-12 bg-gradient-to-br from-saffron-400 to-gold-500 rounded-xl flex items-center justify-center">
                            <i class="fa-solid fa-award text-white text-xl"></i>
                        </div>
                        <div>
                            <p class="font-bold text-gray-800">100%</p>
                            <p class="text-sm text-gray-500">Transparent</p>
                        </div>
                    </div>
                </div>

                <div>
                    <h3 class="font-playfair text-3xl sm:text-4xl font-bold text-gray-800 mb-6">Our <span
                            class="gradient-text">Mission</span> & Values</h3>
                    <p class="text-gray-600 text-lg leading-relaxed mb-5">
                        Founded with the divine blessings of Lord Shri Ram, the <strong>Shree Ram Foundation</strong> is
                        a registered charitable trust committed to <em>"Service Before Self"</em>. We believe that true
                        devotion lies in serving the needy — feeding the hungry, sheltering the helpless, educating the
                        underprivileged, and caring for voiceless animals.
                    </p>
                    <p class="text-gray-600 text-lg leading-relaxed mb-8">
                        Every initiative of ours is guided by the timeless principles of <strong>Dharma</strong>
                        (righteousness), <strong>Karuna</strong> (compassion), and <strong>Sewa</strong> (service). From
                        grand Bhandaras to the quiet care of a wounded street dog, every act counts in our journey to
                        uplift society.
                    </p>

                    <div class="flex flex-wrap gap-3 mb-8">
                        <span
                            class="inline-flex items-center bg-deepred-50 text-deepred-700 border border-deepred-200 rounded-full px-5 py-2.5 text-sm font-semibold">
                            <i class="fa-solid fa-file-signature mr-2 text-deepred-500"></i>
                            Reg No: SRF/2024/108
                        </span>
                        <span
                            class="inline-flex items-center bg-saffron-50 text-saffron-700 border border-saffron-200 rounded-full px-5 py-2.5 text-sm font-semibold">
                            <i class="fa-solid fa-certificate mr-2 text-saffron-500"></i>
                            12A & 80G Certified
                        </span>
                        <span
                            class="inline-flex items-center bg-gold-50 text-gold-700 border border-gold-200 rounded-full px-5 py-2.5 text-sm font-semibold">
                            <i class="fa-solid fa-shield-halved mr-2 text-gold-500"></i>
                            100% Transparent
                        </span>
                    </div>

                    <ul class="space-y-4">
                        <li class="flex items-start space-x-3">
                            <span
                                class="mt-1 w-6 h-6 rounded-full bg-deepred-100 text-deepred-600 flex items-center justify-center flex-shrink-0"><i
                                    class="fa-solid fa-check text-xs"></i></span>
                            <span class="text-gray-700">All donations are eligible for <strong>80G tax
                                    exemption</strong> under Income Tax Act</span>
                        </li>
                        <li class="flex items-start space-x-3">
                            <span
                                class="mt-1 w-6 h-6 rounded-full bg-saffron-100 text-saffron-600 flex items-center justify-center flex-shrink-0"><i
                                    class="fa-solid fa-check text-xs"></i></span>
                            <span class="text-gray-700">Monthly published financial reports & utilization
                                certificates</span>
                        </li>
                        <li class="flex items-start space-x-3">
                            <span
                                class="mt-1 w-6 h-6 rounded-full bg-gold-100 text-gold-600 flex items-center justify-center flex-shrink-0"><i
                                    class="fa-solid fa-check text-xs"></i></span>
                            <span class="text-gray-700">Zero overhead on administration — every rupee goes directly to
                                the cause</span>
                        </li>
                    </ul>
                </div>
            </div>

            <div
                class="bg-gradient-to-br from-deepred-50 via-white to-saffron-50 rounded-3xl p-8 sm:p-12 border border-deepred-100 shadow-xl">
                <div class="grid lg:grid-cols-5 gap-8 items-center">
                    <div class="lg:col-span-1 flex justify-center">
                        <div class="relative">
                            <div
                                class="w-36 h-36 sm:w-44 sm:h-44 rounded-full bg-gradient-to-br from-saffron-400 via-gold-400 to-deepred-500 p-1 shadow-xl">
                                <div class="w-full h-full rounded-full bg-white flex items-center justify-center">
                                    <i class="fa-solid fa-user-tie text-5xl sm:text-6xl text-deepred-500"></i>
                                </div>
                            </div>
                            <div
                                class="absolute -bottom-2 -right-2 w-12 h-12 bg-gold-500 rounded-full flex items-center justify-center shadow-lg border-4 border-white">
                                <i class="fa-solid fa-quote-left text-white"></i>
                            </div>
                        </div>
                    </div>
                    <div class="lg:col-span-4">
                        <h4 class="font-playfair text-2xl font-bold text-gray-800 mb-2">Message from the Managing
                            Trustee</h4>
                        <p class="text-saffron-600 font-medium mb-5">— Shri. Ram Charan Ji, Founder & Chairman</p>
                        <blockquote
                            class="text-gray-700 text-lg leading-relaxed italic border-l-4 border-saffron-400 pl-5">
                            "Service to humanity is service to God. When we feed a hungry soul, shelter a homeless cow,
                            or educate a child who cannot afford books, we do not just perform charity — we uphold the
                            very essence of <strong>Sanatan Dharma</strong>. Shree Ram Foundation is not just an
                            organization; it is a promise — a promise to stand by the last person in the last line. I
                            invite you to join this divine journey of compassion. May Lord Shri Ram bless each one of
                            you."
                        </blockquote>
                        <div class="mt-6 flex items-center space-x-4">
                            <div class="flex -space-x-2">
                                <div
                                    class="w-10 h-10 rounded-full bg-saffron-200 border-2 border-white flex items-center justify-center">
                                    <i class="fa-solid fa-om text-saffron-700 text-sm"></i></div>
                                <div
                                    class="w-10 h-10 rounded-full bg-deepred-200 border-2 border-white flex items-center justify-center">
                                    <i class="fa-solid fa-om text-deepred-700 text-sm"></i></div>
                                <div
                                    class="w-10 h-10 rounded-full bg-gold-200 border-2 border-white flex items-center justify-center">
                                    <i class="fa-solid fa-om text-gold-700 text-sm"></i></div>
                            </div>
                            <span class="text-gray-500 text-sm">Joined by 10,000+ well-wishers</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Our Initiatives / Key Work Cards -->
    <section id="work" class="py-20 sm:py-28 bg-gradient-to-b from-white to-cream-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <span class="inline-block text-deepred-600 font-semibold uppercase tracking-widest text-sm mb-3">What We
                    Do</span>
                <h2 class="font-playfair text-4xl sm:text-5xl font-bold text-gray-800 mb-4">Our <span
                        class="gradient-text">Key Initiatives</span></h2>
                <div class="section-divider mx-auto mb-6"></div>
                <p class="text-gray-600 max-w-2xl mx-auto text-lg">Four pillars of our social welfare work — each driven
                    by devotion and executed with sincerity</p>
            </div>

            <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
                <div class="card-hover bg-white rounded-3xl overflow-hidden shadow-lg border border-gray-100 group">
                    <div class="h-52 overflow-hidden relative">
                        <img src="https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?w=600&q=80"
                            alt="Annadaanam - Free Food Distribution"
                            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110">
                        <div
                            class="absolute inset-0 bg-gradient-to-t from-deepred-800/80 via-transparent to-transparent">
                        </div>
                        <div
                            class="absolute top-4 left-4 w-14 h-14 bg-white/95 backdrop-blur rounded-2xl flex items-center justify-center shadow-lg">
                            <i class="fa-solid fa-bowl-food text-deepred-600 text-2xl"></i>
                        </div>
                    </div>
                    <div class="p-7">
                        <h3 class="font-playfair text-2xl font-bold text-gray-800 mb-3">Annadaanam</h3>
                        <p class="text-sm text-saffron-600 font-semibold uppercase tracking-wider mb-4">Free Food
                            Distribution</p>
                        <p class="text-gray-600 leading-relaxed mb-5">
                            Organizing large-scale <strong>Bhandaras</strong> and daily community kitchens to ensure no
                            one goes to bed hungry. We serve nutritious <em>satvik</em> meals to thousands every month.
                        </p>
                        <ul class="space-y-2 mb-6">
                            <li class="flex items-center text-sm text-gray-600"><i
                                    class="fa-solid fa-circle-check text-saffron-500 mr-2 text-xs"></i>Daily Langar for
                                500+ people</li>
                            <li class="flex items-center text-sm text-gray-600"><i
                                    class="fa-solid fa-circle-check text-saffron-500 mr-2 text-xs"></i>Seasonal Bhandara
                                Events</li>
