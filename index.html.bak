                        </a>
                        <a href="#"
                            class="w-10 h-10 bg-white/10 hover:bg-saffron-500 rounded-xl flex items-center justify-center transition-all hover:-translate-y-1">
                            <i class="fa-brands fa-instagram"></i>
                        </a>
                        <a href="#"
                            class="w-10 h-10 bg-white/10 hover:bg-sky-500 rounded-xl flex items-center justify-center transition-all hover:-translate-y-1">
