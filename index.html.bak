                                    Gallery</span></a></li>
                        <li><a href="#donate"
                                class="text-gray-300 hover:text-gold-300 transition-colors flex items-center space-x-2"><i
                                    class="fa-solid fa-angle-right text-gold-400 text-xs"></i><span>Donate
                                    Now</span></a></li>
                        <li><a href="#"
                                class="text-gray-300 hover:text-gold-300 transition-colors flex items-center space-x-2"><i
                                    class="fa-solid fa-angle-right text-gold-400 text-xs"></i><span>Privacy
                                    Policy</span></a></li>
                        <li><a href="#"
                                class="text-gray-300 hover:text-gold-300 transition-colors flex items-center space-x-2"><i
                                    class="fa-solid fa-angle-right text-gold-400 text-xs"></i><span>Terms &
                                    Conditions</span></a></li>
                        <li><a href="#"
                                class="text-gray-300 hover:text-gold-300 transition-colors flex items-center space-x-2"><i
                                    class="fa-solid fa-angle-right text-gold-400 text-xs"></i><span>Refund &
                                    Cancellation</span></a></li>
                    </ul>
                </div>
            </div>

            <div class="border-t border-white/10 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
                <div class="flex flex-wrap justify-center md:justify-start gap-x-5 gap-y-2 text-sm text-gray-400">
                    <a href="#" class="hover:text-gold-300 transition-colors flex items-center space-x-1"><i
                            class="fa-solid fa-shield-halved text-xs"></i><span>Privacy Policy</span></a>
                    <span class="text-gray-600">•</span>
                    <a href="#" class="hover:text-gold-300 transition-colors flex items-center space-x-1"><i
                            class="fa-solid fa-scale-balanced text-xs"></i><span>Terms & Conditions</span></a>
                    <span class="text-gray-600">•</span>
                    <a href="#" class="hover:text-gold-300 transition-colors flex items-center space-x-1"><i
                            class="fa-solid fa-rotate-left text-xs"></i><span>Refund & Cancellation Policy</span></a>
                </div>
                <p class="text-sm text-gray-400 text-center md:text-right">
                    © <span id="year"></span> <span class="text-gold-300 font-semibold">Shree Ram Foundation</span>. All
                    rights reserved.
                    <span class="block md:inline text-xs text-gray-500">Made with <i
                            class="fa-solid fa-heart text-deepred-500"></i> for Mankind.</span>
                </p>
            </div>
        </div>
    </footer>

    <button id="backToTop" onclick="window.scrollTo({top:0,behavior:'smooth'})"
        class="fixed bottom-6 right-6 w-12 h-12 rounded-full bg-gradient-to-br from-deepred-600 to-saffron-500 text-white shadow-2xl z-40 opacity-0 invisible transition-all duration-300 hover:-translate-y-1 flex items-center justify-center">
        <i class="fa-solid fa-arrow-up"></i>
    </button>

    <div id="copyToast"
        class="fixed bottom-6 left-1/2 -translate-x-1/2 bg-gray-900 text-white px-5 py-3 rounded-xl shadow-2xl z-50 opacity-0 invisible transition-all duration-300 flex items-center space-x-2">
        <i class="fa-solid fa-circle-check text-green-400"></i>
        <span id="copyToastMsg">Copied!</span>
    </div>

    <script>
        document.getElementById('year').textContent = new Date().getFullYear();

        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const mobileMenu = document.getElementById('mobileMenu');
        const closeMenuBtn = document.getElementById('closeMenuBtn');
        const menuOverlay = document.getElementById('menuOverlay');
        const mobileLinks = document.querySelectorAll('.mobile-link');

        function openMenu() {
            mobileMenu.classList.add('active');
            menuOverlay.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }
        function closeMenu() {
            mobileMenu.classList.remove('active');
            menuOverlay.classList.add('hidden');
            document.body.style.overflow = '';
        }
        mobileMenuBtn.addEventListener('click', openMenu);
        closeMenuBtn.addEventListener('click', closeMenu);
        menuOverlay.addEventListener('click', closeMenu);
        mobileLinks.forEach(l => l.addEventListener('click', closeMenu));

        const copyToast = document.getElementById('copyToast');
        const copyToastMsg = document.getElementById('copyToastMsg');
        function copyText(text) {
            navigator.clipboard.writeText(text).then(() => {
                copyToastMsg.textContent = 'Copied: ' + text;
                copyToast.classList.remove('opacity-0', 'invisible');
                setTimeout(() => copyToast.classList.add('opacity-0', 'invisible'), 2000);
            });
        }

        function setAmount(amt) {
            const input = document.querySelector('input[type="number"]');
            if (input) {
                input.value = amt;
                input.focus();
                input.classList.add('ring-4', 'ring-saffron-100', 'border-saffron-500');
                setTimeout(() => input.classList.remove('ring-4', 'ring-saffron-100', 'border-saffron-500'), 1000);
            }
        }

        const backToTop = document.getElementById('backToTop');
        window.addEventListener('scroll', () => {
            if (window.scrollY > 600) {
                backToTop.classList.remove('opacity-0', 'invisible');
            } else {
                backToTop.classList.add('opacity-0', 'invisible');
            }
        });

        document.getElementById('donationForm').addEventListener('submit', (e) => {
            e.preventDefault();
            const btn = e.target.querySelector('button[type="submit"]');
            const originalHTML = btn.innerHTML;
            btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin text-xl"></i><span>Processing...</span>';
            btn.disabled = true;
            setTimeout(() => {
                btn.innerHTML = '<i class="fa-solid fa-circle-check text-xl"></i><span>Form Submitted Successfully!</span>';
                btn.classList.remove('btn-primary');
                btn.classList.add('bg-gradient-to-r', 'from-green-600', 'to-green-700');
                copyToastMsg.textContent = 'Thank you! 80G receipt will be emailed within 48 hours.';
                copyToast.classList.remove('opacity-0', 'invisible');
                setTimeout(() => {
                    e.target.reset();
                    btn.innerHTML = originalHTML;
                    btn.disabled = false;
                    btn.classList.add('btn-primary');
                    btn.classList.remove('bg-gradient-to-r', 'from-green-600', 'to-green-700');
                    copyToast.classList.add('opacity-0', 'invisible');
                }, 4000);
            }, 1500);
        });

        document.addEventListener('click', (e) => {
            const select = e.target.closest('select');
            if (!select) return;
        });
    </script>
</body>

</html>